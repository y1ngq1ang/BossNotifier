<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- SPT 5.0 is IL2CPP only: the plugin is a BepInEx 6 plugin running on the
         game's .NET 10 runtime and referencing the generated interop assemblies. -->
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>BossNotifier</AssemblyName>
    <RootNamespace>BossNotifier</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Version>2.0.0</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Root of the SPT 5.0 install. Override on the command line when the game
         lives somewhere else: dotnet build -p:SptRoot=D:\SPT -->
    <SptRoot Condition="'$(SptRoot)' == ''">C:\SPT-5.0-BE</SptRoot>
  </PropertyGroup>

  <ItemGroup>
    <None Include="custom_bosses.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup Label="BepInEx 6 (IL2CPP)">
    <Reference Include="0Harmony">
      <HintPath>$(SptRoot)\BepInEx\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Core">
      <HintPath>$(SptRoot)\BepInEx\core\BepInEx.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Unity.IL2CPP">
      <HintPath>$(SptRoot)\BepInEx\core\BepInEx.Unity.IL2CPP.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(SptRoot)\BepInEx\core\Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SPTushonka.Reflection">
      <HintPath>$(SptRoot)\BepInEx\plugins\sptushonka\SPTushonka.Reflection.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Label="Interop assemblies (generated by BepInEx on first launch)">
    <Reference Include="Assembly-CSharp">
      <HintPath>$(SptRoot)\BepInEx\interop\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Comfort">
      <HintPath>$(SptRoot)\BepInEx\interop\Comfort.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(SptRoot)\BepInEx\interop\Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(SptRoot)\BepInEx\interop\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(SptRoot)\BepInEx\interop\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(SptRoot)\BepInEx\interop\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(SptRoot)\BepInEx\interop\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Deploy the DLL next to the game like the sibling mod projects do. Skip with
       -p:DeployOnBuild=false when you only want the release zip. -->
  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(DeployOnBuild)' != 'false'">
    <MakeDir Directories="$(SptRoot)\BepInEx\plugins\BossNotifier" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(SptRoot)\BepInEx\plugins\BossNotifier" />
    <Copy SourceFiles="$(TargetDir)custom_bosses.json" DestinationFolder="$(SptRoot)\BepInEx\plugins\BossNotifier" />
  </Target>

  <!-- The release folder + zip are always produced; only the deploy into the game install
       is skipped with -p:DeployOnBuild=false. -->
  <Target Name="PostBuild" AfterTargets="DeployToGame">
    <!-- Build the release folder layout the zip ships with -->
    <MakeDir Directories="$(ProjectDir)release\BepInEx\plugins\BossNotifier" />

    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ProjectDir)release\BepInEx\plugins\BossNotifier" />
    <Copy SourceFiles="$(TargetDir)custom_bosses.json" DestinationFolder="$(ProjectDir)release\BepInEx\plugins\BossNotifier" />

    <ZipDirectory SourceDirectory="$(ProjectDir)release" DestinationFile="$(ProjectDir)BossNotifier-$(Version).zip" Overwrite="true" />
    <RemoveDir Directories="$(ProjectDir)release" />
  </Target>

</Project>
